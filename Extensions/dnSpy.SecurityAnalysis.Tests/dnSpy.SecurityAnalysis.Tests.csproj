<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Fixtures\**\*.cs" />
    <Compile Remove="WorkerFixture\**\*.cs" />
    <ProjectReference Include="..\dnSpy.SecurityAnalysis\dnSpy.SecurityAnalysis.csproj" />
    <ProjectReference Include="Fixtures\HostileFixture.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="WorkerFixture\WorkerFixture.csproj" ReferenceOutputAssembly="false" />
    <None Include="Fixtures\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\HostileFixture.dll" Link="HostileFixture.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyWorkerFixture" AfterTargets="Build">
    <ItemGroup><WorkerFixtureFiles Include="WorkerFixture\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\*" /></ItemGroup>
    <Copy SourceFiles="@(WorkerFixtureFiles)" DestinationFolder="$(OutDir)worker-fixture" />
  </Target>
</Project>
