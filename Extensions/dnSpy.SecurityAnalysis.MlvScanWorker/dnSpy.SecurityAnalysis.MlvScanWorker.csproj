<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>dnSpy.MlvScanWorker</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MLVScan.Core" Version="1.9.0" />
    <Compile Include="..\dnSpy.SecurityAnalysis\MlvScanProtocol.cs" Link="MlvScanProtocol.cs" />
  </ItemGroup>
  <Target Name="CopyRuntimeNotices" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <MlvRuntimePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
    </ItemGroup>
    <Copy SourceFiles="@(MlvRuntimePack->'%(PackageDirectory)/LICENSE.TXT')" DestinationFiles="$(PublishDir)DOTNET-LICENSE.TXT" />
    <Copy SourceFiles="@(MlvRuntimePack->'%(PackageDirectory)/THIRD-PARTY-NOTICES.TXT')" DestinationFiles="$(PublishDir)DOTNET-THIRD-PARTY-NOTICES.TXT" />
  </Target>
</Project>
